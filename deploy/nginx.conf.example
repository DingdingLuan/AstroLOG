# Optional reverse proxy. Start AstroLOG on 127.0.0.1:8765 first.
# Add TLS using your normal Nginx setup for access over the public Internet.
server {
    listen 8080;
    server_name _;

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        # Preserve an explicit port so browser Origin checks also work on :8080.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 90s;
    }

}
